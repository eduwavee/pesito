# Mercado Libre (opcional pero recomendado): creá una app en https://developers.mercadolibre.com.ar/devcenter
# Con client id/secret el server pide el token solo (client_credentials) y lo cachea.
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# o directamente un access token:
# ML_ACCESS_TOKEN=

# DEMO_MODE=1 devuelve precios de ejemplo (para mostrar la UI sin pegarle a las tiendas)
DEMO_MODE=0

# --- Historial y alertas de precio ---
# Postgres (Neon, Supabase, Vercel Postgres...). Sin esto se usa un archivo en .data/,
# que en Vercel no se puede escribir: ahí las alertas quedan deshabilitadas.
# DATABASE_URL=postgres://usuario:clave@host/base
# PRECIOAR_DATA_DIR=.data

# Mails con Resend (https://resend.com). Sin clave, en local el link de confirmación
# se muestra en la consola; en producción no se pueden crear alertas.
# RESEND_API_KEY=
# RESEND_FROM=Pesito <alertas@tudominio.com>

# Protege /api/cron. Obligatorio en producción (Vercel lo manda solo en sus crons).
# CRON_SECRET=

# URL pública para los links de los mails (si no, se usa VERCEL_URL o localhost)
# NEXT_PUBLIC_SITE_URL=https://tudominio.com
